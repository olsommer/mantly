{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mantly.io/schemas/pilot-ticket-metric.schema.json",
  "title": "Mantly pilot ticket metric",
  "description": "One privacy-minimized final metric record for an eligible or explicitly excluded pilot ticket.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pilot_id",
    "tenant_id",
    "ticket_id",
    "source_message_id",
    "received_at",
    "eligibility",
    "handling_classification"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "pilot_id": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "ticket_id": {
      "type": "string",
      "minLength": 1
    },
    "source_message_id": {
      "type": "string",
      "minLength": 1
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    },
    "first_response_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    },
    "observation_window_end": {
      "type": "string",
      "format": "date-time"
    },
    "eligibility": {
      "type": "string",
      "enum": ["eligible", "excluded"]
    },
    "exclusion_reason": {
      "type": "string",
      "enum": [
        "spam_or_malware",
        "duplicate_ingestion",
        "workflow_out_of_scope",
        "source_system_outage",
        "customer_withdrawal_or_deletion",
        "synthetic_or_training",
        "other_preapproved"
      ]
    },
    "runbook_id": {
      "type": "string",
      "minLength": 1
    },
    "runbook_version": {
      "type": "string",
      "minLength": 1
    },
    "match_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "match_review": {
      "type": "string",
      "enum": ["correct", "incorrect", "not_reviewed", "no_match_expected"]
    },
    "handling_classification": {
      "type": "string",
      "enum": [
        "verified_autonomous",
        "autonomous_candidate_observing",
        "assisted",
        "manual",
        "failed_automation",
        "excluded"
      ]
    },
    "autonomous_candidate": {
      "type": "boolean"
    },
    "human_touch_count": {
      "type": "integer",
      "minimum": 0
    },
    "approval_required": {
      "type": "boolean"
    },
    "draft_generated": {
      "type": "boolean"
    },
    "material_edit": {
      "type": "boolean"
    },
    "action_attempts": {
      "type": "integer",
      "minimum": 0
    },
    "action_failures": {
      "type": "integer",
      "minimum": 0
    },
    "duplicate_side_effect": {
      "type": "boolean"
    },
    "delivery_status": {
      "type": "string",
      "enum": ["not_required", "sent", "delivered", "failed"]
    },
    "delivery_attempts": {
      "type": "integer",
      "minimum": 0
    },
    "review_result": {
      "type": "string",
      "enum": ["pass", "minor_issue", "major_issue", "critical_issue", "not_reviewed"]
    },
    "review_categories": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "runbook_match",
          "customer_context",
          "policy_grounding",
          "factual_correctness",
          "action_correctness",
          "permission_or_approval",
          "response_completeness",
          "tone_or_language",
          "disclosure",
          "delivery",
          "trace_completeness",
          "tenant_isolation",
          "other"
        ]
      }
    },
    "unsafe_or_materially_incorrect": {
      "type": "boolean"
    },
    "critical_outcome": {
      "type": "boolean"
    },
    "recovery_required": {
      "type": "boolean"
    },
    "model_provider": {
      "type": "string",
      "minLength": 1
    },
    "model_name": {
      "type": "string",
      "minLength": 1
    },
    "input_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "output_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "llm_cost": {
      "type": "number",
      "minimum": 0
    },
    "tool_and_delivery_cost": {
      "type": "number",
      "minimum": 0
    },
    "human_minutes": {
      "type": "number",
      "minimum": 0
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "Permission-controlled record identifiers; never copy customer message bodies into the metric dataset.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "eligibility": {"const": "excluded"}
        }
      },
      "then": {
        "required": ["exclusion_reason"],
        "properties": {
          "handling_classification": {"const": "excluded"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "eligibility": {"const": "eligible"}
        }
      },
      "then": {
        "required": [
          "first_response_at",
          "resolved_at",
          "match_review",
          "autonomous_candidate",
          "human_touch_count",
          "approval_required",
          "draft_generated",
          "material_edit",
          "action_attempts",
          "action_failures",
          "duplicate_side_effect",
          "delivery_status",
          "delivery_attempts",
          "review_result",
          "review_categories",
          "unsafe_or_materially_incorrect",
          "critical_outcome",
          "recovery_required",
          "input_tokens",
          "output_tokens",
          "llm_cost",
          "tool_and_delivery_cost",
          "human_minutes",
          "evidence_refs"
        ],
        "properties": {
          "handling_classification": {
            "enum": [
              "verified_autonomous",
              "autonomous_candidate_observing",
              "assisted",
              "manual",
              "failed_automation"
            ]
          }
        },
        "not": {
          "required": ["exclusion_reason"]
        }
      }
    },
    {
      "if": {
        "properties": {
          "match_review": {
            "enum": ["correct", "incorrect"]
          }
        },
        "required": ["match_review"]
      },
      "then": {
        "required": ["runbook_id", "runbook_version", "match_confidence"]
      }
    },
    {
      "if": {
        "properties": {
          "match_review": {"const": "no_match_expected"}
        },
        "required": ["match_review"]
      },
      "then": {
        "not": {
          "anyOf": [
            {"required": ["runbook_id"]},
            {"required": ["runbook_version"]},
            {"required": ["match_confidence"]}
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "handling_classification": {"const": "verified_autonomous"}
        }
      },
      "then": {
        "required": [
          "runbook_id",
          "runbook_version",
          "observation_window_end"
        ],
        "properties": {
          "autonomous_candidate": {"const": true},
          "human_touch_count": {"const": 0},
          "approval_required": {"const": false},
          "material_edit": {"const": false},
          "action_failures": {"const": 0},
          "duplicate_side_effect": {"const": false},
          "delivery_status": {"enum": ["sent", "delivered"]},
          "review_result": {"const": "pass"},
          "unsafe_or_materially_incorrect": {"const": false},
          "critical_outcome": {"const": false},
          "recovery_required": {"const": false}
        }
      }
    },
    {
      "if": {
        "properties": {
          "handling_classification": {"const": "autonomous_candidate_observing"}
        }
      },
      "then": {
        "required": [
          "runbook_id",
          "runbook_version",
          "observation_window_end"
        ],
        "properties": {
          "autonomous_candidate": {"const": true}
        }
      }
    },
    {
      "if": {
        "properties": {
          "material_edit": {"const": true}
        },
        "required": ["material_edit"]
      },
      "then": {
        "properties": {
          "human_touch_count": {"minimum": 1}
        }
      }
    },
    {
      "if": {
        "properties": {
          "critical_outcome": {"const": true}
        },
        "required": ["critical_outcome"]
      },
      "then": {
        "properties": {
          "unsafe_or_materially_incorrect": {"const": true},
          "review_result": {"const": "critical_issue"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "review_result": {"const": "critical_issue"}
        },
        "required": ["review_result"]
      },
      "then": {
        "properties": {
          "unsafe_or_materially_incorrect": {"const": true},
          "critical_outcome": {"const": true}
        }
      }
    },
    {
      "if": {
        "properties": {
          "duplicate_side_effect": {"const": true}
        },
        "required": ["duplicate_side_effect"]
      },
      "then": {
        "properties": {
          "unsafe_or_materially_incorrect": {"const": true}
        }
      }
    }
  ]
}
